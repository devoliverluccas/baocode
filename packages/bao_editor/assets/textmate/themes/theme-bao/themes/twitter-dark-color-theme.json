	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#88888C"
			}
		},
		{
			"scope": [
				"constant.other.placeholder",
				"constant.character"
			],
			"settings": {
				"foreground": "#53CFFF"
			}
		},
		{
			"scope": [
				"constant",
				"entity.name.constant",
				"variable.other.constant",
				"variable.other.enummember",
				"variable.language",
				"entity"
			],
			"settings": {
				"foreground": "#9AB0CC"
			}
		},
		{
			"scope": [
				"entity.name",
				"meta.export.default",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#8FC1B5"
			}
		},
		{
			"scope": [
				"variable.parameter.function",
				"meta.jsx.children",
				"meta.block",
				"meta.tag.attributes",
				"entity.name.constant",
				"meta.object.member",
				"meta.embedded.expression"
			],
			"settings": {
				"foreground": "#DCDCE1"
			}
		},
		{
			"scope": "entity.name.function",
			"settings": {
				"foreground": "#C3B1DA"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"support.class.component"
			],
			"settings": {
				"foreground": "#9CC4A0"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "#53CFFF"
			}
		},
		{
			"scope": [
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "#53CFFF"
			}
		},
		{
			"scope": [
				"storage.modifier.package",
				"storage.modifier.import",
				"storage.type.java"
			],
			"settings": {
				"foreground": "#DCDCE1"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source"
			],
			"settings": {
				"foreground": "#B4C48E"
			}
		},
		{
			"scope": "support",
			"settings": {
				"foreground": "#9AB0CC"
			}
		},
		{
			"scope": "meta.property-name",
			"settings": {
				"foreground": "#9AB0CC"
			}
		},
		{
			"scope": "variable",
			"settings": {
				"foreground": "#8FC1B5"
			}
		},
		{
			"scope": "variable.other",
			"settings": {
				"foreground": "#DCDCE1"
			}
		},
		{
			"scope": "invalid.broken",
			"settings": {
				"foreground": "#EC9A8D",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "invalid.deprecated",
			"settings": {
				"foreground": "#EC9A8D",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "invalid.illegal",
			"settings": {
				"foreground": "#EC9A8D",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "invalid.unimplemented",
			"settings": {
				"foreground": "#EC9A8D",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "carriage-return",
			"settings": {
				"foreground": "#F0F0F5",
				"fontStyle": "italic underline"
			}
		},
		{
			"scope": "message.error",
			"settings": {
				"foreground": "#EC9A8D"
			}
		},
		{
			"scope": "string variable",
			"settings": {
				"foreground": "#9AB0CC"
			}
		},
		{
			"scope": [
				"source.regexp",
				"string.regexp"
			],
			"settings": {
				"foreground": "#B4C48E"
			}
		},
		{
			"scope": [
