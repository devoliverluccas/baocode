	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#858589"
			}
		},
		{
			"scope": [
				"constant.other.placeholder",
				"constant.character"
			],
			"settings": {
				"foreground": "#007AC7"
			}
		},
		{
			"scope": [
				"constant",
				"entity.name.constant",
				"variable.other.constant",
				"variable.other.enummember",
				"variable.language",
				"entity"
			],
			"settings": {
				"foreground": "#3E6A96"
			}
		},
		{
			"scope": [
				"entity.name",
				"meta.export.default",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#2F7A6C"
			}
		},
		{
			"scope": [
				"variable.parameter.function",
				"meta.jsx.children",
				"meta.block",
				"meta.tag.attributes",
				"entity.name.constant",
				"meta.object.member",
				"meta.embedded.expression"
			],
			"settings": {
				"foreground": "#29292C"
			}
		},
		{
			"scope": "entity.name.function",
			"settings": {
				"foreground": "#7A55A8"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"support.class.component"
			],
			"settings": {
				"foreground": "#3D7A47"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "#007AC7"
			}
		},
		{
			"scope": [
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "#007AC7"
			}
		},
		{
			"scope": [
				"storage.modifier.package",
				"storage.modifier.import",
				"storage.type.java"
			],
			"settings": {
				"foreground": "#29292C"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source"
			],
			"settings": {
				"foreground": "#5E7A26"
			}
		},
		{
			"scope": "support",
			"settings": {
				"foreground": "#3E6A96"
			}
		},
		{
			"scope": "meta.property-name",
			"settings": {
				"foreground": "#3E6A96"
			}
		},
		{
			"scope": "variable",
			"settings": {
				"foreground": "#2F7A6C"
			}
		},
		{
			"scope": "variable.other",
			"settings": {
				"foreground": "#29292C"
			}
		},
		{
			"scope": "invalid.broken",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#B0443A"
			}
		},
		{
			"scope": "invalid.deprecated",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#B0443A"
			}
		},
		{
			"scope": "invalid.illegal",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#B0443A"
			}
		},
		{
			"scope": "invalid.unimplemented",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#B0443A"
			}
		},
		{
			"scope": "carriage-return",
			"settings": {
				"fontStyle": "italic underline",
				"foreground": "#F0F0F4"
			}
		},
		{
			"scope": "message.error",
			"settings": {
				"foreground": "#B0443A"
			}
		},
		{
			"scope": "string variable",
			"settings": {
				"foreground": "#3E6A96"
			}
		},
		{
			"scope": [
				"source.regexp",
				"string.regexp"
			],
			"settings": {
				"foreground": "#5E7A26"
			}
		},
		{
			"scope": [
